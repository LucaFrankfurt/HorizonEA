# ---------------------------------------------------------------------------
# HorizonEA configuration – copy to .env and adjust.
# Next.js (npm run dev / start) and docker compose both read this file.
# On Coolify you don't need this file: set the same variables in the
# resource's "Environment Variables" tab (secrets are generated for you).
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# Leave DATABASE_URL unset to use the embedded PostgreSQL (PGlite, WASM) that
# is stored on disk in PGLITE_DATA_DIR – zero setup, ideal for local use.
# Set it to use a real PostgreSQL server (14+):
# DATABASE_URL=postgres://horizon:horizon@localhost:5432/horizon
# DATABASE_POOL_SIZE=10
# PGLITE_DATA_DIR=./data/pglite

# Load the demo landscape when the app starts against a brand-new database.
# Default: true for the embedded database, false for PostgreSQL.
SEED_DEMO_DATA=true

# Allow "Reset demo data" / "Clear all data" on the Import / Export page and
# POST /api/demo-data. Set to false on shared or production instances.
ALLOW_DEMO_RESET=true

# Currency used for budgets (ISO code; baked into the client bundle at build time).
NEXT_PUBLIC_CURRENCY=EUR

# --- Login (optional HTTP Basic Auth for UI + API) ---------------------------
# Leave BASIC_AUTH_PASSWORD empty to disable the login (e.g. local development).
# BASIC_AUTH_USER=admin
# BASIC_AUTH_PASSWORD=

# --- docker compose -----------------------------------------------------------
# Names follow Coolify's "magic" variables: Coolify generates and stores them
# automatically. For a local compose run, set them here.
SERVICE_PASSWORD_POSTGRES=change-me-please
# Password for the "admin" login (empty = no login)
SERVICE_PASSWORD_LOGIN=
# Host port used by docker-compose.local.yml
APP_PORT=3000
